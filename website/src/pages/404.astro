---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/LingXia-Dev/Rong";
---

<Layout
  title="Page not found · Rong"
  description="The requested page does not exist on the Rong documentation site."
>
  <section class="not-found">
    <div class="container not-found-inner">
      <p class="error-code">404 / 未找到</p>
      <h1>This path ends here.</h1>
      <p>
        The page may have moved, or the address may be incomplete.<br />
        页面可能已移动，或地址不完整。
      </p>
      <div class="not-found-actions">
        <a class="btn btn-primary" href={`${base}/`}>Back to Rong</a>
        <a class="text-link" href={repo} target="_blank" rel="noopener">Browse the repository →</a>
      </div>
      <div class="not-found-glyph" aria-hidden="true">融</div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    align-items: center;
    min-height: calc(100dvh - 68px);
    overflow: hidden;
  }
  .not-found-inner {
    position: relative;
    padding-block: clamp(96px, 14vw, 180px);
  }
  .error-code {
    margin-bottom: 18px;
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 720px;
    font-size: clamp(3rem, 9vw, 7rem);
    letter-spacing: -0.055em;
  }
  .not-found-inner > p:not(.error-code) {
    max-width: 580px;
    margin-top: 24px;
    font-size: clamp(1rem, 2vw, 1.18rem);
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 36px;
  }
  .text-link {
    color: var(--text-muted);
    font-weight: 600;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .text-link:hover {
    color: var(--jade);
    transform: translateX(3px);
  }
  .not-found-glyph {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -4%;
    color: var(--jade);
    font-size: min(42vw, 520px);
    font-weight: 800;
    line-height: 1;
    opacity: 0.06;
    transform: translateY(-50%);
    user-select: none;
  }
</style>
